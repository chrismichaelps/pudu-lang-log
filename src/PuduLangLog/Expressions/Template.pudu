/** @Log.Expressions.Template.Engine — output templates of expressions and directives */
module PuduLangLog.Expressions.Template

import Std.List as List
import PuduLangLog.Domain.Display as Display
import PuduLangLog.Domain.Json as Json
import PuduLangLog.Domain.Levels as Levels
import PuduLangLog.Expressions.Evaluator as Evaluator
import PuduLangLog.Expressions.Lexer as Lexer
import PuduLangLog.Expressions.Parser as Parser
import PuduLangLog.Expressions.Syntax as Syntax
import PuduLangLog.Expressions.Values as Values
import PuduLangLog as Log

/** @Log.Expressions.Template.Node — literal text, a hole, or a directive block */
export type Node = TextNode(Str)
  | Hole(Syntax.Expression, Option[Str])
  | Choice(Array[Branch], Array[Node])
  | Each(Str, Option[Str], Syntax.Expression, Array[Node], Array[Node], Array[Node])

/** @Log.Expressions.Template.Branch — a condition and the nodes it guards */
export type Branch = { condition: Syntax.Expression, body: Array[Node] }

/** @Log.Expressions.Template.Piece — a scanned part before blocks are nested */
type Piece = Literal(Str) | Placeholder(Str) | Directive(Str)

/// The template's nodes, or why it could not be read.
export fn parse(text: Str) -> Result[Array[Node], Str] {
  let pieces = scan(text) ?
  let (nodes, next, closer) = block(&pieces, 0) ?
  if closer != "" { return Err("unexpected `\{#" + closer + "\}`") }
  if next < pieces.length() { return Err("unexpected directive") }
  Ok(nodes)
}

/// Every expression in the nodes, in order.
export fn expressionsIn(nodes: &Array[Node]) -> Array[Syntax.Expression] {
  var found: Array[Syntax.Expression] = []
  for node in nodes {
    found = found.concat(match node {
        case TextNode(_) => []
        case Hole(expression, _) => [expression]
        case Choice(branches, otherwise) => {
          var inner: Array[Syntax.Expression] = []
          for branch in branches { inner = inner.push(branch.condition).concat(expressionsIn(&branch.body)) }
          inner.concat(expressionsIn(&otherwise))
        }
        case Each(_, _, source, body, delimiter, empty) => [source].concat(expressionsIn(&body)).concat(expressionsIn(&delimiter)).concat(expressionsIn(&empty))
      })
  }
  found
}

/// The text split into literals, holes, and directives; doubled braces are literal braces.
fn scan(text: Str) -> Result[Array[Piece], Str] {
  let characters = text.chars()
  var pieces: Array[Piece] = []
  var literal: Array[Str] = []
  var index = 0
  while index < characters.length() {
    let character = characters[index]
    let doubled = List.get(&characters, index + 1) == Some(character)
    if (character == '\{' || character == '\}') && doubled {
      literal = literal.push(character.toText())
      index = index + 2
    } else if character == '\{' {
      if !literal.isEmpty() { pieces = pieces.push(Literal(literal.join(""))) }
      literal = []
      let close = closing(&characters, index + 1) ?
      let content = text.slice(index + 1, close).trim()
      pieces = pieces.push(if content.startsWith("#") { Directive(content.drop(1).trim()) } else { Placeholder(content) })
      index = close + 1
    } else {
      literal = literal.push(character.toText())
      index = index + 1
    }
  }
  if !literal.isEmpty() { pieces = pieces.push(Literal(literal.join(""))) }
  Ok(pieces)
}

/// The index of the brace closing a hole, skipping nested braces, brackets, and quoted text.
fn closing(characters: &Array[Char], start: Int) -> Result[Int, Str] {
  var depth = 0
  var quoted = false
  var index = start
  while index < characters.length() {
    let character = characters[index]
    if quoted {
      if character == '\'' { quoted = false }
    } else if character == '\'' {
      quoted = true
    } else if character == '\{' || character == '[' {
      depth = depth + 1
    } else if character == ']' {
      depth = depth - 1
    } else if character == '\}' {
      if depth == 0 { return Ok(index) }
      depth = depth - 1
    }
    index = index + 1
  }
  Err("a hole opened at " + show(start - 1) + " is not closed")
}

/// Nodes until the end or a directive that closes the enclosing block, the index after them, and
/// that directive's text.
fn block(pieces: &Array[Piece], start: Int) -> Result[(Array[Node], Int, Str), Str] {
  var nodes: Array[Node] = []
  var index = start
  while index < pieces.length() {
    match pieces[index] {
      case Literal(text) => {
        nodes = nodes.push(TextNode(text))
        index = index + 1
      }
      case Placeholder(content) => {
        nodes = nodes.push(holeOf(content) ?)
        index = index + 1
      }
      case Directive(content) => {
        if content == "end" || content == "else" || content == "delimit" || content.startsWith("else if ") { return Ok((nodes, index + 1, content)) }
        let (node, next) = if content.startsWith("if ") { choiceAt(pieces, index + 1, content.drop(3)) ? } else if content.startsWith("each ") { eachAt(pieces, index + 1, content.drop(5)) ? } else { return Err("unknown directive `\{#" + content + "\}`") }
        nodes = nodes.push(node)
        index = next
      }
    }
  }
  Ok((nodes, index, ""))
}

/// A hole: an expression and an optional format after its first top-level `:`.
fn holeOf(content: Str) -> Result[Node, Str] {
  let found = Lexer.tokens(content) ?
  let (expression, next) = Parser.expressionAt(&found, 0) ?
  let token = found[next]
  if token.kind == Lexer.End { return Ok(Hole(expression, None)) }
  if token.kind == Lexer.Symbol && token.text == ":" { return Ok(Hole(expression, Some(content.drop(token.position + 1)))) }
  Err("unexpected `" + token.text + "` in hole `" + content + "`")
}

/// An `#if` block with its `#else if` and `#else` parts, and the index after its `#end`.
fn choiceAt(pieces: &Array[Piece], start: Int, condition: Str) -> Result[(Node, Int), Str] {
  var branches: Array[Branch] = []
  var current = Parser.parse(condition) ?
  var index = start
  loop {
    let (body, next, closer) = block(pieces, index) ?
    branches = branches.push(Branch{condition: current, body: body})
    if closer == "end" { return Ok((Choice(branches, []), next)) }
    if closer == "else" {
      let (otherwise, after, final) = block(pieces, next) ?
      if final != "end" { return Err("`\{#else\}` must be followed by `\{#end\}`") }
      return Ok((Choice(branches, otherwise), after))
    }
    if !closer.startsWith("else if ") { return Err("`\{#if\}` is not closed") }
    current = Parser.parse(closer.drop(8)) ?
    index = next
  }
}

/// An `#each` block with its optional `#delimit` and `#else` parts, and the index after its `#end`.
fn eachAt(pieces: &Array[Piece], start: Int, header: Str) -> Result[(Node, Int), Str] {
  let parts = header.split(" in ")
  if parts.length() < 2 { return Err("`\{#each\}` needs `in`") }
  let names = parts[0].split(",").map(|name: Str| name.trim())
  let source = Parser.parse(parts.slice(1, parts.length()).join(" in ")) ?
  let second = List.get(&names, 1)
  let (body, afterBody, closer) = block(pieces, start) ?
  var delimiter: Array[Node] = []
  var empty: Array[Node] = []
  var next = afterBody
  var last = closer
  if last == "delimit" {
    let (inner, after, final) = block(pieces, next) ?
    delimiter = inner
    next = after
    last = final
  }
  if last == "else" {
    let (inner, after, final) = block(pieces, next) ?
    empty = inner
    next = after
    last = final
  }
  if last != "end" { return Err("`\{#each\}` is not closed") }
  Ok((Each(names[0], second, source, body, delimiter, empty), next))
}

/// The nodes rendered for an event.
export fn render(nodes: &Array[Node], within: &Evaluator.Scope) -> Str {
  var out: Array[Str] = []
  for node in nodes {
    out = out.push(match node {
        case TextNode(text) => text
        case Hole(expression, format) => holeText(&expression, &format, within)
        case Choice(branches, otherwise) => {
          match List.find(&branches, |branch: Branch| Values.isTrue(&Evaluator.evaluate(&branch.condition, within))) {
            case Some(branch) => render(&branch.body, within)
            case None => render(&otherwise, within)
          }
        }
        case Each(name, second, source, body, delimiter, empty) => eachText(name, &second, &source, &body, &delimiter, &empty, within)
      })
  }
  out.join("")
}

/// A hole's text: nothing when undefined, levels and messages by their own rules, text as it is,
/// scalars under the format, and anything else as JSON.
fn holeText(expression: &Syntax.Expression, format: &Option[Str], within: &Evaluator.Scope) -> Str {
  if *expression == Syntax.Name("@l") { return Levels.moniker(within.event.level, format) }
  if *expression == Syntax.Name("@m") { return Display.plain(&Display.message(&within.event.template, &within.event.properties, &Some("lj"))) }
  match Evaluator.evaluate(expression, within) {
    case None => ""
    case Some(Log.Scalar(atom)) => Values.render(&Log.Scalar(atom), *format)
    case Some(held) => Json.value(&held, &Some(Display.TYPE_TAG))
  }
}

/// An `#each` block rendered once per element or member, delimited, or its `#else` part when there
/// is none.
fn eachText(name: Str, second: &Option[Str], source: &Syntax.Expression, body: &Array[Node], delimiter: &Array[Node], empty: &Array[Node], within: &Evaluator.Scope) -> Str {
  let bindings: Array[(Log.Value, Log.Value)] = match Evaluator.evaluate(source, within) {
    case Some(Log.Sequence(items)) => {
      var pairs: Array[(Log.Value, Log.Value)] = []
      var position = 0
      for item in items {
        pairs = pairs.push((item, Log.Scalar(Log.Integer(position))))
        position = position + 1
      }
      pairs
    }
    case Some(Log.Structure(shape)) => shape.properties.map(|member: Log.Property| (Log.Scalar(Log.Text(member.name)), member.value))
    case _ => []
  }
  if bindings.isEmpty() { return render(empty, within) }
  var parts: Array[Str] = []
  for binding in bindings {
    var bound = [(name, binding[0])]
    if let Some(other) = *second { bound = bound.push((other, binding[1])) }
    let inner = Evaluator.Scope{..*within, locals: bound.concat(within.locals)}
    parts = parts.push(render(body, &inner))
  }
  parts.join(render(delimiter, within))
}
